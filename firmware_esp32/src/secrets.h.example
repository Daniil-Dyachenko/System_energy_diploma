/*
 * Energy_System_Diploma — firmware secrets template (PlatformIO + VSCode build)
 *
 * Copy this file to `secrets.h` in the same directory and fill in your real
 * values.
 */
#pragma once

// VSCode-Wokwi extension exposes the host machine at host.wokwi.internal,
//  Change the port only if Django listens on something other than 8000.
#define SERVER_URL    "http://host.wokwi.internal:8000"

// Must equal DEVICE_API_KEY in the Django .env file.
#define API_KEY       "your-device-api-key-here"

// Wokwi's built-in WiFi (works inside the simulator without password).
#define WIFI_SSID     "Wokwi-GUEST"
#define WIFI_PASSWORD ""