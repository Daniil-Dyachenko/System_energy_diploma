#For Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,host.wokwi.internal,.ngrok-free.app,.ngrok.app,.ngrok-free.dev,.lhr.life,.lhr.run

#For Database (PostgreSQL)
POSTGRES_DB=name_db
POSTGRES_USER=name_user
POSTGRES_PASSWORD=your_name_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# IoT (ESP32) authentication is per-device: each Device has its own api_key,
# auto-generated and stored in the database (view/rotate it in the Django admin).

#For Web container port (host side)
WEB_PORT=8000
